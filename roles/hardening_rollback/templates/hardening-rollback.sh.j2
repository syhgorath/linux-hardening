#!/bin/sh
# Ansible tarafından yönetilir (hardening_rollback). Elle düzenlemeyin.
#
#   hardening-rollback arm      önceki durumu yedekler (zaten armed ise yedeği korur), zamanlayıcıyı başlatır
#   hardening-rollback disarm   değişiklik onaylandı: armed'ı ve yedeği siler, zamanlayıcıyı durdurur
#   hardening-rollback restore  önceki duruma döner (zamanlayıcı bunu çağırır); armed değilse hiçbir şey yapmaz
#   hardening-rollback status   durumu TEK satir olarak yazar (kararli anahtarlar; docs/design/rollback-timer.md 4.4)
#
# Kapsam: sshd drop-in, ufw dosyaları, Proxmox pve-firewall (cluster.fw) ve PAM (common-* dosyaları, /var/lib/pam durumu, hardening-faillock profili, faillock.conf). PAM geri alınırken
# kilit sayaçları (/run/faillock) da silinir: geri alma kimseyi kilitli bırakmamalı.
#
# Test için ortam değişkenleri: HR_ROOT (yol öneki), HR_UFW, HR_PVEFW, HR_SSHD, HR_SYSTEMCTL, HR_SSH_SERVICE, HR_NOW (epoch saniye).
set -eu

ROOT="${HR_ROOT:-}"
STATE="$ROOT/var/lib/hardening-rollback"
ARMED="$STATE/armed"
DROPIN="$ROOT/etc/ssh/sshd_config.d/00-hardening.conf"
UFWDIR="$ROOT/etc/ufw"
UFW="${HR_UFW:-ufw}"
PVEFW="${HR_PVEFW:-pve-firewall}"
PVE_FW_FILE="$ROOT/etc/pve/firewall/cluster.fw"
SSHD="${HR_SSHD:-/usr/sbin/sshd}"
SYSTEMCTL="${HR_SYSTEMCTL:-systemctl}"
DEFAULT_SSH_SERVICE='{{ hardening_ssh_service | default("ssh") }}'
SSH_SERVICE="${HR_SSH_SERVICE:-$DEFAULT_SSH_SERVICE}"
TIMER="hardening-rollback.timer"
TIMEOUT_SECONDS={{ hardening_rollback_timeout | int }}
UFW_FILES="ufw.conf user.rules user6.rules"
PAMDIR="$ROOT/etc/pam.d"
PAMSTATEDIR="$ROOT/var/lib/pam"
PAMCONFIGS="$ROOT/usr/share/pam-configs"
FAILLOCK_PROFILE_NAME='hardening-faillock*'
FAILLOCK_CONF="$ROOT/etc/security/faillock.conf"
FAILLOCK_TALLY="$ROOT/run/faillock"
PAM_FILES="common-auth common-account common-password common-session common-session-noninteractive"
PAM_STATE_FILES="account auth password session session-noninteractive seen"

# systemd altinda (INVOCATION_ID dolu) stdout zaten journal'a (hardening-rollback etiketiyle) gider; logger'i da
# cagirmak her satiri iki kez kaydederdi. Elle/Ansible calistirmada stdout journal'a gitmez: logger ile yazilir.
log() {
  if [ -z "${INVOCATION_ID:-}" ]; then
    logger -t hardening-rollback -- "$*" 2>/dev/null || true
  fi
  echo "$*"
}

do_backup() {
  mkdir -p "$STATE/ufw"
  chmod 0700 "$STATE"
  rm -f "$STATE/had-dropin" "$STATE/00-hardening.conf" "$STATE/ufw-active"
  for f in $UFW_FILES; do rm -f "$STATE/ufw/$f"; done
  pam_clear_backup
  if [ -e "$DROPIN" ]; then
    cp -p "$DROPIN" "$STATE/00-hardening.conf"
    : > "$STATE/had-dropin"
  fi
  for f in $UFW_FILES; do
    if [ -e "$UFWDIR/$f" ]; then cp -p "$UFWDIR/$f" "$STATE/ufw/$f"; fi
  done
  pam_backup
  pve_backup
  if "$UFW" status 2>/dev/null | grep -q '^Status: active'; then
    echo yes > "$STATE/ufw-active"
  else
    echo no > "$STATE/ufw-active"
  fi
}

# Proxmox pve-firewall (yalnizca /etc/pve/firewall dizini varsa): cluster.fw ve guvenlik duvarinin acik/kapali durumu.
# pmxcfs (FUSE) chown/chmod desteklemez: cp -p yerine cat ile yalniz ICERIK kopyalanir.
pve_clear_backup() {
  rm -rf "$STATE/pve-firewall"
}

pve_backup() {
  pve_clear_backup
  if [ -d "$(dirname "$PVE_FW_FILE")" ]; then
    mkdir -p "$STATE/pve-firewall"
    if [ -e "$PVE_FW_FILE" ]; then
      cat "$PVE_FW_FILE" > "$STATE/pve-firewall/cluster.fw"
      : > "$STATE/pve-firewall/had-file"
    fi
    : > "$STATE/pve-firewall/present"
  fi
}

pve_restore() {
  if [ -e "$STATE/pve-firewall/present" ]; then
    if [ -e "$STATE/pve-firewall/had-file" ]; then
      cat "$STATE/pve-firewall/cluster.fw" > "$PVE_FW_FILE" || log "UYARI: cluster.fw geri yazilamadi"
      log "pve-firewall cluster.fw onceki icerige donduruldu"
    else
      rm -f "$PVE_FW_FILE" || log "UYARI: cluster.fw silinemedi"
      log "pve-firewall cluster.fw onceden yoktu: silindi"
    fi
    # kurallar hemen uygulansin; olmazsa son care: guvenlik duvarini durdur (kurallar kalkar)
    if ! "$PVEFW" restart >/dev/null 2>&1; then
      log "UYARI: pve-firewall restart basarisiz; pve-firewall stop deneniyor"
      "$PVEFW" stop >/dev/null 2>&1 || log "UYARI: pve-firewall stop basarisiz"
    fi
  fi
}

pam_clear_backup() {
  rm -rf "$STATE/pam" "$STATE/pam-state" "$STATE/faillock-profiles"
  rm -f "$STATE/had-faillock-conf" "$STATE/faillock.conf"
}

pam_backup() {
  mkdir -p "$STATE/pam" "$STATE/pam-state" "$STATE/faillock-profiles"
  for f in $PAM_FILES; do
    if [ -e "$PAMDIR/$f" ]; then cp -p "$PAMDIR/$f" "$STATE/pam/$f"; fi
  done
  for f in $PAM_STATE_FILES; do
    if [ -e "$PAMSTATEDIR/$f" ]; then cp -p "$PAMSTATEDIR/$f" "$STATE/pam-state/$f"; fi
  done
  # faillock profilleri (ad onekiyle): arm anindaki hepsi saklanir
  if [ -d "$PAMCONFIGS" ]; then
    find "$PAMCONFIGS" -maxdepth 1 -type f -name "$FAILLOCK_PROFILE_NAME" -exec cp -p {} "$STATE/faillock-profiles/" \; 2>/dev/null || true
  fi
  if [ -e "$FAILLOCK_CONF" ]; then
    cp -p "$FAILLOCK_CONF" "$STATE/faillock.conf"
    : > "$STATE/had-faillock-conf"
  fi
}

pam_restore() {
  # PAM dosyalari OLDUGU GIBI (arm anindaki hallerine) geri yazilir; pam-auth-update calistirilmaz (yigin bozuksa o da bozuk calisabilir)
  if [ -d "$STATE/pam" ]; then
    for f in $PAM_FILES; do
      if [ -e "$STATE/pam/$f" ]; then cp -p "$STATE/pam/$f" "$PAMDIR/$f"; fi
    done
    log "PAM dosyalari onceki icerige donduruldu"
  fi
  if [ -d "$STATE/pam-state" ]; then
    for f in $PAM_STATE_FILES; do
      if [ -e "$STATE/pam-state/$f" ]; then cp -p "$STATE/pam-state/$f" "$PAMSTATEDIR/$f"; fi
    done
  fi
  # simdiki faillock profilleri silinir, arm anindakiler (varsa) geri yazilir
  find "$PAMCONFIGS" -maxdepth 1 -type f -name "$FAILLOCK_PROFILE_NAME" -delete 2>/dev/null || true
  if [ -d "$STATE/faillock-profiles" ]; then
    find "$STATE/faillock-profiles" -maxdepth 1 -type f -exec cp -p {} "$PAMCONFIGS/" \; 2>/dev/null || true
  fi
  if [ -e "$STATE/had-faillock-conf" ]; then
    cp -p "$STATE/faillock.conf" "$FAILLOCK_CONF"
  fi
  # kilit sayaclari: geri alma kimseyi kilitli birakmamali (yalniz /run/faillock icindeki dosyalar)
  if [ -d "$FAILLOCK_TALLY" ]; then find "$FAILLOCK_TALLY" -mindepth 1 -maxdepth 1 -type f -delete 2>/dev/null || true; fi
}

do_arm() {
  mkdir -p "$STATE"
  chmod 0700 "$STATE"
  if [ -e "$ARMED" ]; then
    log "zaten armed: ilk yedek korunuyor, geri sayim yenileniyor"
  else
    do_backup
    : > "$ARMED"
  fi
  "$SYSTEMCTL" enable "$TIMER" >/dev/null 2>&1 || true
  "$SYSTEMCTL" restart "$TIMER"
  # armed dosyasina bitis zamani (epoch) yazilir: status kalan sureyi buradan hesaplar (dosyanin varligi hala armed demektir)
  echo $(( ${HR_NOW:-$(date +%s)} + TIMEOUT_SECONDS )) > "$ARMED"
  log "armed"
}

do_disarm() {
  was_armed=0
  [ -e "$ARMED" ] && was_armed=1
  rm -f "$ARMED" "$STATE/had-dropin" "$STATE/00-hardening.conf" "$STATE/ufw-active"
  for f in $UFW_FILES; do rm -f "$STATE/ufw/$f"; done
  rmdir "$STATE/ufw" 2>/dev/null || true
  pam_clear_backup
  pve_clear_backup
  "$SYSTEMCTL" disable --now "$TIMER" >/dev/null 2>&1 || true
  if [ "$was_armed" = 1 ]; then
    log "disarmed"
  else
    log "armed degil: yapilacak bir sey yok"
  fi
}

do_restore() {
  if [ ! -e "$ARMED" ]; then
    log "armed degil: yapilacak bir sey yok"
    exit 0
  fi
  # PAM EN ONCE: bozuk bir yigin giris ve sudo'yu kapatir; ssh/ufw geri alma adimlari bir nedenle takilsa bile PAM dondurulmus olmali
  pam_restore
  # ssh: onceki drop-in icerigini geri yaz; yoksa sil
  if [ -e "$STATE/had-dropin" ]; then
    cp -p "$STATE/00-hardening.conf" "$DROPIN"
    log "sshd drop-in onceki icerige donduruldu"
  else
    rm -f "$DROPIN"
    log "sshd drop-in onceden yoktu: silindi"
  fi
  if "$SSHD" -t >/dev/null 2>&1; then
    "$SYSTEMCTL" reload "$SSH_SERVICE" || log "UYARI: sshd reload basarisiz"
  else
    log "UYARI: sshd -t basarisiz; sshd reload edilmedi"
  fi
  # ufw: yedekteki dosyalari geri yaz, aktif/pasif durumunu eski haline getir
  if [ -e "$STATE/ufw-active" ] && command -v "$UFW" >/dev/null 2>&1; then
    for f in $UFW_FILES; do
      if [ -e "$STATE/ufw/$f" ]; then cp -p "$STATE/ufw/$f" "$UFWDIR/$f"; fi
    done
    if [ "$(cat "$STATE/ufw-active")" = "yes" ]; then
      "$UFW" --force enable >/dev/null 2>&1 || log "UYARI: ufw enable basarisiz"
      log "ufw onceki kurallarla aktif birakildi"
    else
      "$UFW" --force disable >/dev/null 2>&1 || log "UYARI: ufw disable basarisiz"
      log "ufw onceden pasifti: pasif birakildi"
    fi
  fi
  pve_restore
  rm -f "$ARMED"
  pam_clear_backup
  pve_clear_backup
  "$SYSTEMCTL" disable --now "$TIMER" >/dev/null 2>&1 || true
  log "geri alma tamamlandi"
}

do_status() {
  armed=no remaining=unknown
  if [ -e "$ARMED" ]; then
    armed=yes
    deadline=$(cat "$ARMED" 2>/dev/null || true)
    case "$deadline" in
      ''|*[!0-9]*) ;;   # bos ya da sayi degil (eski surum): bilinmiyor
      *)
        remaining=$(( deadline - ${HR_NOW:-$(date +%s)} ))
        if [ "$remaining" -lt 0 ]; then remaining=0; fi
        ;;
    esac
  fi
  timer=$("$SYSTEMCTL" is-active "$TIMER" 2>/dev/null || true)
  if [ -z "$timer" ]; then timer=unknown; fi
  echo "SSHPOCKET_RESULT linux-hardening.rollback_status installed=yes armed=$armed timer=$timer remaining_seconds=$remaining timeout_seconds=$TIMEOUT_SECONDS"
}

case "${1:-}" in
  arm) do_arm ;;
  disarm) do_disarm ;;
  restore) do_restore ;;
  status) do_status ;;
  *) echo "kullanim: hardening-rollback arm|disarm|restore|status" >&2; exit 2 ;;
esac
