# Ansible tarafından yönetilir
PermitRootLogin {{ hardening_ssh_permit_root_login }}
PasswordAuthentication {{ 'no' if hardening_ssh_disable_password else 'yes' }}
PermitEmptyPasswords no
KbdInteractiveAuthentication {{ 'yes' if hardening_ssh_kbdinteractive else 'no' }}
{% if hardening_ssh_kbdinteractive %}
AuthenticationMethods publickey,keyboard-interactive
{% endif %}
PubkeyAuthentication yes
MaxAuthTries {{ hardening_ssh_max_auth_tries }}
MaxSessions {{ hardening_ssh_max_sessions }}
LoginGraceTime {{ hardening_ssh_login_grace_time }}
LogLevel {{ hardening_ssh_log_level }}
X11Forwarding {{ 'yes' if hardening_ssh_x11_forwarding else 'no' }}
AllowTcpForwarding {{ hardening_ssh_allow_tcp_forwarding }}
AllowAgentForwarding {{ 'yes' if hardening_ssh_agent_forwarding else 'no' }}
{% if hardening_ssh_allow_tcp_forwarding == 'no' %}
DisableForwarding yes
{% endif %}
GSSAPIAuthentication no
HostbasedAuthentication no
IgnoreRhosts yes
PermitUserEnvironment no
UsePAM yes
MaxStartups {{ hardening_ssh_max_startups }}
MACs -hmac-md5,hmac-md5-96,hmac-ripemd160,hmac-sha1-96,umac-64@openssh.com,hmac-md5-etm@openssh.com,hmac-md5-96-etm@openssh.com,hmac-ripemd160-etm@openssh.com,hmac-sha1-96-etm@openssh.com,umac-64-etm@openssh.com,umac-128-etm@openssh.com
TCPKeepAlive no
ClientAliveInterval {{ hardening_ssh_client_alive_interval }}
ClientAliveCountMax {{ hardening_ssh_client_alive_count_max }}
Banner /etc/issue.net
{% if hardening_ssh_allow_users | length > 0 %}
AllowUsers {{ hardening_ssh_allow_users | join(' ') }}
{% endif %}
{% if hardening_ssh_allow_groups | length > 0 %}
AllowGroups {{ hardening_ssh_allow_groups | join(' ') }}
{% endif %}
